diff --git a/integration-tests/http/__tests__/cart/store/promotion-feedback.spec.ts b/integration-tests/http/__tests__/cart/store/promotion-feedback.spec.ts
new file mode 100644
--- /dev/null
+++ b/integration-tests/http/__tests__/cart/store/promotion-feedback.spec.ts
@@ -0,0 +1,58 @@
+import { medusaIntegrationTestRunner } from "@medusajs/test-utils"
+import {
+  createAdminUser,
+  adminHeaders,
+} from "../../../../helpers/create-admin-user"
+import { setupCartWithPromotions } from "../../../../helpers/promotions"
+
+jest.setTimeout(100000)
+
+medusaIntegrationTestRunner({
+  testSuite: ({ dbConnection, api, getContainer }) => {
+    describe("POST /store/carts/:id/promotions - skipped codes", () => {
+      beforeEach(async () => {
+        await createAdminUser(dbConnection, adminHeaders, getContainer())
+      })
+
+      it("lists a code whose usage limit is reached", async () => {
+        const { cart, storeHeaders } = await setupCartWithPromotions(api, {
+          promotions: [{ code: "SUMMER10", limit: 100, used: 100 }],
+        })
+
+        const response = await api.post(
+          `/store/carts/${cart.id}/promotions`,
+          { promo_codes: ["SUMMER10"] },
+          storeHeaders
+        )
+
+        expect(response.status).toEqual(200)
+        expect(response.data.cart.promotions).toEqual([])
+        expect(response.data.skipped_promo_codes).toEqual([
+          { code: "SUMMER10", reason: "promotion_limit_exceeded" },
+        ])
+      })
+
+      it("applies valid codes and lists only the failed one", async () => {
+        const { cart, storeHeaders } = await setupCartWithPromotions(api, {
+          promotions: [
+            { code: "SUMMER10", limit: 100, used: 100 },
+            { code: "WELCOME5" },
+          ],
+        })
+
+        const response = await api.post(
+          `/store/carts/${cart.id}/promotions`,
+          { promo_codes: ["SUMMER10", "WELCOME5"] },
+          storeHeaders
+        )
+
+        expect(response.data.cart.promotions).toEqual([
+          expect.objectContaining({ code: "WELCOME5" }),
+        ])
+        expect(response.data.skipped_promo_codes).toEqual([
+          { code: "SUMMER10", reason: "promotion_limit_exceeded" },
+        ])
+      })
+    })
+  },
+})
